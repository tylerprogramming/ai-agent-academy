# Browser (Vite). Values are inlined into the built bundle, so they are public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase edge function secrets for supabase/functions/chatkit-session.
# Set these with `supabase secrets set`, not in this file.
# OPENAI_API_SECRET_KEY=sk-...
# CHATKIT_WORKFLOW_ID=wf_...
